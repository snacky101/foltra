{
  "name": "foltra-desktop",
  "version": "0.1.0-preview.5",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-storage.mjs check && cargo build --locked -p foltra-cli && node scripts/build-storage.mjs check",
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "release:mac": "tauri build --config src-tauri/tauri.release.conf.json --bundles app,dmg --ci",
    "tauri": "tauri",
    "core:build": "cargo build --locked -p foltra-cli",
    "test": "cargo test -p foltra-core -p foltra-cli && vitest run && node --test scripts/release-update.test.mjs scripts/build-storage.test.mjs scripts/clean-build-cache.test.mjs",
    "check": "npm run plugins:check && npm run build && cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings",
    "format": "prettier --write src vite.config.ts && cargo fmt --all",
    "plugin:pack": "node scripts/pack-plugin.mjs",
    "plugins:build": "node scripts/build-example-plugins.mjs",
    "plugins:check": "tsc -p packages/plugin-sdk/tsconfig.examples.json",
    "prebuild": "node scripts/build-storage.mjs check && npm run plugins:build",
    "pretest": "node scripts/build-storage.mjs check && npm run plugins:build && node scripts/build-test-plugins.mjs",
    "pretauri": "node scripts/build-storage.mjs check",
    "prerelease:mac": "node scripts/build-storage.mjs check",
    "precore:build": "node scripts/build-storage.mjs check",
    "precheck": "node scripts/build-storage.mjs check",
    "posttauri": "node scripts/build-storage.mjs check",
    "postrelease:mac": "node scripts/build-storage.mjs check",
    "postcore:build": "node scripts/build-storage.mjs check",
    "postcheck": "node scripts/build-storage.mjs check",
    "posttest": "node scripts/build-storage.mjs check",
    "postbuild": "node scripts/build-storage.mjs check"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.11.0",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.0",
    "@lezer/highlight": "^1.2.3",
    "@lezer/markdown": "^1.7.2",
    "@replit/codemirror-vim": "^6.4.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "@tauri-apps/plugin-opener": "^2.5.5",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.11.0",
    "d3-force": "^3.0.0",
    "lucide-react": "^0.577.0",
    "micromark-util-decode-string": "^2.0.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/d3-force": "^3.0.10",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "typescript": "^6.0.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.0"
  }
}
