{
  "name": "foltra-desktop",
  "version": "0.1.0-preview.1",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "cargo build -p foltra-cli",
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "release:mac": "tauri build --bundles app,dmg --ci",
    "tauri": "tauri",
    "core:build": "cargo build -p foltra-cli",
    "test": "cargo test -p foltra-core -p foltra-cli && vitest run",
    "check": "npm run build && cargo fmt --all -- --check && cargo clippy --workspace --all-targets -- -D warnings",
    "format": "prettier --write src vite.config.ts && cargo fmt --all"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.0",
    "@codemirror/lang-markdown": "^6.5.0",
    "@codemirror/language": "^6.11.0",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.38.0",
    "@lezer/markdown": "^1.7.2",
    "@replit/codemirror-vim": "^6.4.0",
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "^2.6.0",
    "d3-force": "^3.0.0",
    "lucide-react": "^0.577.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/d3-force": "^3.0.10",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.0",
    "vite": "^8.3.0",
    "vitest": "^4.1.0"
  }
}
