{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Foltra",
  "version": "0.1.0-preview.17",
  "identifier": "app.foltra.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "beforeBundleCommand": "node scripts/bundle-cli.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Foltra",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false,
        "trafficLightPosition": {
          "x": 16,
          "y": 20
        },
        "width": 1360,
        "height": 900,
        "minWidth": 900,
        "minHeight": 620
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; connect-src ipc: http://ipc.localhost; font-src 'self'; object-src 'none'; frame-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "macOS": {
      "files": {
        "MacOS/foltra": "../target/bundle-cli/foltra"
      },
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "targets": ["app"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJDRTVERTlEN0VEODRENQpSV1RWaE8zWDZWM09BaDdhblhkSmpUVGEvSEpFOTFnYU0xbktCcVBBWjhwWURFL3FkdUJydzZzOAo=",
      "endpoints": ["https://github.com/snacky101/foltra/releases/download/updater/latest.json"]
    }
  }
}
