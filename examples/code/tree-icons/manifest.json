{
  "kind": "plugin",
  "id": "tree-icons",
  "name": "파일 트리 아이콘",
  "version": "1.0.0",
  "description": "노트·폴더·데이터베이스의 기본 아이콘과 파일별 아이콘을 바꿉니다. 설정에서 대상을 검색하고 20가지 아이콘 중 선택하세요.",
  "commands": [
    { "id": "settings", "title": "파일 트리 아이콘 설정", "action": { "type": "script" } }
  ],
  "runtime": {
    "apiVersion": 1,
    "permissions": ["notes.read", "databases.read", "ui"],
    "treeIcons": true,
    "settingsView": "settings",
    "views": [{ "id": "settings", "title": "파일 트리 아이콘" }]
  }
}
