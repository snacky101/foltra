    "id": "topics.list",
    "title": "List topics from linked paragraphs and list blocks",
    "readOnly": true,
    "headless": true,
    "argsSchema": {
      "type": "object",
      "properties": {
        "folders": {
          "type": "object",
          "properties": {
            "include": { "type": "array", "items": { "type": "string" }, "maxItems": 1000 },
            "exclude": { "type": "array", "items": { "type": "string" }, "maxItems": 1000 }
          },
          "required": ["include", "exclude"],
          "additionalProperties": false,
          "description": "Folder IDs include descendants; empty ID selects root notes only. Empty include means all. Exclude wins."
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  {
    "id": "topics.blocks",
    "title": "Collect paragraphs and list subtrees for a topic",
    "readOnly": true,
    "headless": true,
    "argsSchema": {
      "type": "object",
      "properties": {
        "folders": {
          "type": "object",
          "properties": {
            "include": { "type": "array", "items": { "type": "string" }, "maxItems": 1000 },
            "exclude": { "type": "array", "items": { "type": "string" }, "maxItems": 1000 }
          },
          "required": ["include", "exclude"],
          "additionalProperties": false,
          "description": "Folder IDs include descendants; empty ID selects root notes only. Empty include means all. Exclude wins."
        },
        "topic": {
          "type": "string",
          "description": "Opaque topic ID from topics.list"
        },
        "limit": {
          "type": "integer",
          "description": "1–100 blocks, default 50"
        },
        "offset": {
          "type": "integer"
        },
        "descending": {
          "type": "boolean",
          "description": "Newest source-note creation date first, default true"
        },
        "sort": {
          "type": "string",
          "enum": [
            "newest",
            "oldest",
            "custom"
          ],
          "description": "Defaults to saved custom order, otherwise newest. Overrides descending."
        }
      },
      "required": [
        "topic"
      ],
      "additionalProperties": false
    }
  },
